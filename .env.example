# ---------------------------------------------------------------------------
# Book catalog pipeline configuration. Copy to .env and fill in as needed.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# SQLite file (default). The repository layer is abstracted; see README for Postgres.
DATABASE_URL=file:./data/catalog.db

# --- API server ------------------------------------------------------------
PORT=3000
# Bearer token required for POST /api/catalog/* and /api/admin/*.
# If empty, those endpoints are open ONLY when NODE_ENV != production.
ADMIN_API_TOKEN=
NODE_ENV=development

# --- Google Books (OPTIONAL but strongly recommended) ----------------------
# Anonymous access has a shared quota that is frequently 0/day; without a key
# the Google Books provider is skipped and Open Library is used alone.
GOOGLE_BOOKS_API_KEY=
# Country used for saleInfo (prices are returned in that country's currency).
GOOGLE_BOOKS_COUNTRY=IN

# --- Open Library (no key needed) -----------------------------------------
# Open Library asks API clients to identify themselves. Put a contact email
# for your deployment here; it is sent in the User-Agent header.
OPEN_LIBRARY_CONTACT_EMAIL=
OPEN_LIBRARY_EDITIONS_PER_WORK=8

# --- Amazon Product Advertising API (OPTIONAL) -----------------------------
# Provider is disabled unless all three are set. Requires an approved
# Associates account; confirm the current API version in Amazon's docs.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_HOST=webservices.amazon.in
AMAZON_REGION=eu-west-1

# --- Pipeline --------------------------------------------------------------
BOOK_IMPORT_BATCH_SIZE=100
# Default minimum delay between requests to the same host.
BOOK_REQUEST_DELAY_MS=500
BOOK_REQUEST_TIMEOUT_MS=15000
BOOK_MAX_RETRIES=4
# Cache TTLs
BOOK_METADATA_CACHE_DAYS=30
BOOK_PRICE_CACHE_HOURS=12
BOOK_IMAGE_CACHE_DAYS=30
# primary | all | none  (HEAD-check cover URLs before import)
BOOK_IMAGE_VALIDATION=primary
# Fuzzy duplicate probability at/above which a record is quarantined for review.
BOOK_DUPLICATE_QUARANTINE_THRESHOLD=0.9
# Where pipeline artifacts live.
BOOK_DATA_DIR=./data
LOG_LEVEL=info
